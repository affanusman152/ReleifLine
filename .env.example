# Copy these into the Alternate Clouds "Variables" tab (never commit real values).

# Must match the PORT on the Alternate Clouds Source tab.
PORT=8000
# Your public service URL, e.g. https://reliefline-app.alternatefutures.ai
PUBLIC_URL=

# Coordinator dashboard key (give a demo key to judges in the submission PDF).
DASHBOARD_KEY=change-me
# Phones become coordinators by sending: COORDINATOR <code>
COORDINATOR_CODE=change-me

# Groq: https://console.groq.com/keys (check model ids at https://console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=reliefline-verify
# App settings → Basic → App secret (optional; enables webhook signature checks)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Telegram fallback channel (@BotFather → /newbot). Webhook is set automatically from PUBLIC_URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Map centre (default: Multan). Demo volunteers are seeded around it; SEED_DEMO=0 disables them.
MAP_CENTER_LAT=30.1575
MAP_CENTER_LNG=71.5249
SEED_DEMO=1
